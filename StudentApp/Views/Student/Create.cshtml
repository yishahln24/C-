@model StudentApp.Models.Student

<h2>Register Student</h2>

<form asp-controller="Student" asp-action="Create" method="post" class="w-50">
    <div class="mb-3">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName"class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Course" class="form-label"></label>
        <input asp-for="Course"class="form-control" />
        <span asp-validation-for="Course" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="YearLevel" class="form-label"></label>
        <input asp-for="YearLevel"class="form-control" />
        <span asp-validation-for="YearLevel" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Save Student</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>